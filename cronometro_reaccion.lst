                      00159 ; ============================================================
                      00160 ;  LOOP PRINCIPAL
                      00161 ;  LEER_ADC solo se llama cuando se está esperando (no jugando
                      00162 ;  ni congelado). Así los LEDs no cambian durante la prueba.
                      00163 ; ============================================================
0063                  00164 LOOP:
0063   1879           00165     BTFSC   TERMINADO, 0
0064   2863           00166     GOTO    LOOP            ; congelado → solo esperar IRQ RB0
                      00167 
0065   1878           00168     BTFSC   JUGANDO, 0
0066   2863           00169     GOTO    LOOP            ; jugando  → solo esperar IRQ RB0/T0
                      00170 
                      00171     ; ESPERANDO: leer ADC, actualizar LEDs, detectar cambio rango
0067   2070           00172     CALL    LEER_ADC        ; W = rango (1/2/3), actualiza LEDs
0068   027E           00173     SUBWF   RANGO_PREV, W
0069   1D03           00174     BTFSS   STATUS, Z
006A   286C           00175     GOTO    RANGO_CAMBIO
006B   2863           00176     GOTO    LOOP
