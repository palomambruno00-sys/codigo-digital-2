                      00001 ; ============================================================
                      00002 ; Cronómetro de Reacción - PIC16F887 - 4MHz interno
                      00003 ; UART 9600,8N1
                      00004 ;
                      00005 ; Rangos:
                      00006 ;   Rango 1 – Rojo    (ADC 0-85)    – Joven        – 500ms
                      00007 ;   Rango 2 – Verde   (ADC 86-170)  – Adulto mayor – 1000ms
                      00008 ;   Rango 3 – Amarillo(ADC 171-255) – Paciente ACV – 1500ms
                      00009 ;
                      00010 ; Flujo:
                      00011 ;   1) Ajustar potenciómetro → LED indica categoría
                      00012 ;   2) Mantener rango 1 segundo → cronómetro arranca solo
                      00013 ;   3) Presionar RB0 durante prueba → display congela + UART mensaje
                      00014 ;   4) Presionar RB0 congelado → reset
                      00015 ; ============================================================
